const isAntd = name in ANTD_PATHS;
const paths = isAntd ? ANTD_PATHS[name] : (PATHS[name] ?? []);
if (!paths.length) {
  // Fail loudly at build time rather than silently rendering an empty box —
  // a missing glyph is exactly the kind of drift these previews exist to avoid.
  throw new Error(
    `MgaIcon: unknown icon "${name}". Known: ${[...Object.keys(PATHS), ...Object.keys(ANTD_PATHS)].join(', ')}`
  );
}
