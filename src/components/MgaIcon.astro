{
  isAntd ? (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="64 64 896 896"
      fill="currentColor"
      width={size}
      height={size}
      aria-hidden="true"
      class={className}
    >
      {paths.map((d) => (
        <path d={d} />
      ))}
    </svg>
  ) : (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      width={size}
      height={size}
      aria-hidden="true"
      class={className}
    >
      {paths.map((d) => (
        <path stroke-linecap="round" stroke-linejoin="round" d={d} />
      ))}
    </svg>
  )
}
