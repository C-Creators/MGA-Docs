---
/**
 * The Live Chat workspace: conversation list + takeover console.
 *
 * Mirrors routes/crm/support/LiveChatSection.tsx, which is exactly two panes —
 * `flex gap-4`, a `lg:w-[340px] lg:shrink-0` list and a `flex-1` ChatPane.
 * There is no third column: CrmActionsPanel is an antd <Drawer width={400}>
 * opened from the header button, so at rest it is off-screen. Earlier previews
 * drew it as a permanent rail, which both misrepresented the UI and squeezed
 * the chat down to a few words per line.
 *
 * The console is skinned per channel by getChannelTheme() — this one is the
 * WHATSAPP.light entry, so the header is #075E54, the thread #ece5dd and the
 * outgoing bubbles #dcf8c6. The customer sits on the LEFT and you on the RIGHT
 * (`isCustomer ? justify-start : justify-end`).
 */
/*
 * On showing one pane at a time: the app's Live Chat is 840px of FIXED chrome
 * before the chat even starts (260 shell nav + 240 portal nav + 340 list), and
 * it is designed against a max-w-[1600px] page. A docs column cannot hold that,
 * and squeezing it is what produced chat bubbles three words wide. So each
 * preview renders its panes at their REAL widths and simply shows fewer of
 * them — the alternative, scaling everything down, would make a page about
 * pixel-accuracy render at the wrong pixel sizes.
 */
import MgaIcon from "./MgaIcon.astro";

interface Props {
  lang?: 'en' | 'es';
  /** Render the 340px conversation list. */
  queue?: boolean;
  /** Render the takeover console. */
  chat?: boolean;
}

const { lang = 'en', queue = true, chat = true } = Astro.props;

const T = {
  en: {
    queue: [
      {
        name: 'María López',
        time: '1m',
        preview: "My order hasn't arrived and it's been 8 days.",
        tags: [{ label: 'Waiting', tone: 'orange' }],
        active: true,
      },
      {
        name: 'Diego Fernández',
        time: '4m',
        preview: '↩ I just refunded the difference — you should see it today.',
        tags: [{ label: 'Ana', tone: 'green' }],
      },
      {
        name: '+506 7011 3382',
        time: '12m',
        preview: 'Does the screen fit a 2019 Hilux?',
        tags: [
          { label: 'Waiting', tone: 'orange' },
          { label: 'SLA', tone: 'red' },
        ],
      },
    ],
    presence: 'Online',
    takeOver: 'Take over',
    resolve: 'Resolve',
    thread: [
      { side: 'user', text: "My order hasn't arrived and it's been 8 days.", time: '09:14' },
      {
        side: 'bot',
        text: 'Sorry about the delay. I can see order #4471 shipped on 12 July. Let me check its status with the carrier.',
        time: '09:14',
      },
      {
        side: 'user',
        text: 'They told me that last week too. I want to talk to a person.',
        time: '09:15',
      },
      { side: 'bot', text: "Understood — I'm connecting you with an agent now.", time: '09:15' },
      { divider: 'Ana took over · bot paused' },
      {
        side: 'agent',
        sender: 'Ana',
        text: "Hi María, Ana here. I have your case in front of me — the parcel was held at customs and I'm releasing it today.",
        time: '09:16',
      },
    ],
    composer: 'Type a reply…',
    send: 'Send',
  },
  es: {
    queue: [
      {
        name: 'María López',
        time: '1m',
        preview: 'Mi pedido no ha llegado y ya pasaron 8 días.',
        tags: [{ label: 'En espera', tone: 'orange' }],
        active: true,
      },
      {
        name: 'Diego Fernández',
        time: '4m',
        preview: '↩ Ya te devolví la diferencia — debería reflejarse hoy.',
        tags: [{ label: 'Ana', tone: 'green' }],
      },
      {
        name: '+506 7011 3382',
        time: '12m',
        preview: '¿La pantalla sirve para una Hilux 2019?',
        tags: [
          { label: 'En espera', tone: 'orange' },
          { label: 'SLA', tone: 'red' },
        ],
      },
    ],
    presence: 'En línea',
    takeOver: 'Tomar el control',
    resolve: 'Resolver',
    thread: [
      { side: 'user', text: 'Mi pedido no ha llegado y ya pasaron 8 días.', time: '09:14' },
      {
        side: 'bot',
        text: 'Lamento la demora. Veo el pedido #4471 despachado el 12 de julio. Déjame revisar el estado con la transportadora.',
        time: '09:14',
      },
      {
        side: 'user',
        text: 'Ya me dijeron eso la semana pasada. Quiero hablar con una persona.',
        time: '09:15',
      },
      { side: 'bot', text: 'Entendido — te estoy conectando con un agente.', time: '09:15' },
      { divider: 'Ana tomó el control · bot pausado' },
      {
        side: 'agent',
        sender: 'Ana',
        text: 'Hola María, soy Ana. Ya tengo tu caso al frente — el paquete quedó retenido en aduana y lo estoy liberando hoy.',
        time: '09:16',
      },
    ],
    composer: 'Escribe una respuesta…',
    send: 'Enviar',
  },
}[lang];
---

<div class="mga-app__split">
  {queue && (
  <div class="mga-app__queue">
    {
      T.queue.map((c) => (
        <div
          class:list={['mga-app__queue-item', c.active && 'mga-app__queue-item--active']}
        >
          <span class="mga-app__queue-badge">
            <MgaIcon name="whatsapp" size={14} />
          </span>
          <span class="mga-app__queue-main">
            <span class="mga-app__queue-top">
              <span class="mga-app__queue-name">{c.name}</span>
              <span class="mga-app__queue-time">{c.time}</span>
            </span>
            <span class="mga-app__queue-preview">{c.preview}</span>
            <span class="mga-app__queue-tags">
              {c.tags.map((t) => (
                <span class={`mga-app__queue-tag mga-app__queue-tag--${t.tone}`}>{t.label}</span>
              ))}
            </span>
          </span>
        </div>
      ))
    }
  </div>
  )}

  {chat && (
  <div class="mga-app__chat-pane">
    <div class="mga-app__chat-head">
      <span class="mga-app__chat-head-icon">
        <MgaIcon name="whatsapp" size={20} />
      </span>
      <span class="mga-app__chat-head-main">
        <span class="mga-app__chat-head-name">María López</span>
        <span class="mga-app__chat-head-meta">
          <span>WhatsApp</span>
          <span>· Soporte CR</span>
          <span class="mga-app__chat-presence">
            <span class="mga-app__chat-presence-dot"></span>{T.presence}
          </span>
        </span>
      </span>
      {/*
        Take-over and Resolve are MUTUALLY EXCLUSIVE in ChatPane: the first is
        gated on `isPending` (handoffStatus === 'PENDING') and the second on
        `isLive` (=== 'IN_PROGRESS'), so exactly one can ever be on screen.
        Ana has already taken this conversation over, so it is Resolve.
      */}
      <span class="mga-app__chat-head-actions">
        <span class="mga-app__chat-head-btn">
          <MgaIcon name="check-circle" size={12} />{T.resolve}
        </span>
        <span class="mga-app__chat-head-btn mga-app__chat-head-btn--icon">
          <MgaIcon name="idcard" size={14} />
        </span>
        <span class="mga-app__chat-head-btn mga-app__chat-head-btn--icon">
          <MgaIcon name="export" size={14} />
        </span>
      </span>
    </div>

    <div class="mga-app__chat-thread">
      {
        T.thread.map((m) =>
          m.divider ? (
            <div class="mga-app__chat-divider">{m.divider}</div>
          ) : (
            <div class={`mga-app__chat-bubble mga-app__chat-bubble--${m.side}`}>
              {m.sender && <span class="mga-app__chat-sender">{m.sender}</span>}
              {m.text}
              <span class="mga-app__chat-time">{m.time}</span>
            </div>
          )
        )
      }
    </div>

    <div class="mga-app__chat-composer">
      <span class="mga-app__chat-composer-attach"><MgaIcon name="paper-clip" size={16} /></span>
      <div class="mga-app__chat-composer-input">{T.composer}</div>
      <button class="mga-app__btn mga-app__btn--primary" type="button" tabindex="-1">{T.send}</button>
    </div>
  </div>
  )}
</div>
