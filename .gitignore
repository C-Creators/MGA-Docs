# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# Shrimp task manager data
.shrimp-data/

# GitHub Copilot agents
.github/agents/

# VS Code MCP config (contains API keys)
.vscode/mcp.json

# This project builds with npm (package-lock.json) and the deploy workflow
# picks its package manager from whichever lockfile is present. A stray
# pnpm-lock.yaml silently switches CI to pnpm and fails the deploy, so keep
# pnpm's artifacts out of the repo even if someone runs pnpm locally.
pnpm-lock.yaml
pnpm-workspace.yaml
